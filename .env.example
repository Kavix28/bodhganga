# =============================================================================
# BodhGanga — Environment Variable Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env  (DO NOT commit .env — it is in .gitignore)
#   2. Fill in every value marked REQUIRED
#   3. Mount google-credentials.json and google-qb-credentials.json as
#      Docker secrets / secret volumes — never commit those files.
# =============================================================================

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=REQUIRED_CHANGE_ME
MONGO_URI=mongodb://admin:REQUIRED_CHANGE_ME@mongodb:27017/bodhganga?authSource=admin

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=REQUIRED_MINIMUM_64_CHARACTERS_REPLACE_THIS_VALUE
JWT_EXPIRATION=86400000

# ── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=REQUIRED
AWS_SECRET_ACCESS_KEY=REQUIRED
AWS_REGION=ap-south-1
AWS_S3_BUCKET=bodhganga-prod

# ── Google Drive — State Material Pipeline ────────────────────────────────────
# Mount the JSON file as a Docker secret / Cloud Run secret volume.
# Set this env var to the mounted path:
GOOGLE_DRIVE_CREDENTIALS_PATH=/run/secrets/google-credentials.json
GOOGLE_DRIVE_PIPELINE_ENABLED=false
GOOGLE_DRIVE_SOURCE_FOLDER_ID=REQUIRED_WHEN_PIPELINE_ENABLED
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=REQUIRED_WHEN_PIPELINE_ENABLED

# ── Google Drive — Question Bank Pipeline (INDEPENDENT credentials) ───────────
# Mount the QB service account JSON separately from the State pipeline.
QB_CREDENTIALS_PATH=/run/secrets/google-qb-credentials.json
QB_PIPELINE_ENABLED=false
QB_SOURCE_FOLDER_ID=REQUIRED_WHEN_QB_PIPELINE_ENABLED
QB_ARCHIVE_FOLDER_ID=REQUIRED_WHEN_QB_PIPELINE_ENABLED
QB_SYNC_INTERVAL_MS=600000

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=REQUIRED_WHEN_QB_PIPELINE_ENABLED
GEMINI_MODEL=gemini-2.5-flash

# ── Payment (Razorpay) ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=REQUIRED
RAZORPAY_KEY_SECRET=REQUIRED

# ── SMS / OTP (MSG91) ────────────────────────────────────────────────────────
MSG91_AUTH_KEY=REQUIRED_WHEN_OTP_ENABLED
OTP_ENABLED=true

# ── SMTP / Email ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REQUIRED
SMTP_PASS=REQUIRED

# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=OPTIONAL
YOUTUBE_CHANNEL_ID=OPTIONAL

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://bodhganga.in,https://www.bodhganga.in

# ── Spring Profile ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://bodhganga.in/api
